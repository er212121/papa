{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "papa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3add953d-13b7-4fc1-b80c-a67ecf30b5c1","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cd35b980d4714edbb31b3b07a34807df" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
